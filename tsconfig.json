{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "outDir": "out",
        "lib": [
            "es6"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "types": ["node", "webpack-env", "jest"]
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "test"
    ]
}
